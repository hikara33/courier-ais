# Скопируйте в .env (файл .env в репозиторий не попадает) и поменяйте пароли
POSTGRES_DB=courier
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
CORE_DB_PASSWORD=change_me_core
DISPATCH_DB_PASSWORD=change_me_dispatch
TRACKING_DB_PASSWORD=change_me_tracking
NOTIFY_DB_PASSWORD=change_me_notify
RABBITMQ_USER=courier
RABBITMQ_PASSWORD=change_me_mq
# Ключ Яндекс Карт (геокодирование и маршруты). Без него Диспетчеризация работает в деградированном режиме
YANDEX_MAPS_API_KEY=
